{
    "allowed_origin": "http://127.0.0.1:8000",
    "allowed_methods": ["GET"],
    "allowed_path_patterns": [
        "/",
        "/search",
        "/members/[0-9]{5}",
        "/members/[0-9]{5}/accounts/savings"
    ],
    "allowed_query_keys": {
        "/search": ["member_id"]
    },
    "allowed_actions": ["fill", "click", "read"],
    "allowed_fill_labels": ["Member ID"],
    "allowed_clicks": [{
            "kind": "role",
            "role": "button",
            "name": "Search"
        },
        {
            "kind": "role",
            "role": "link",
            "name": "Open member"
        },
        {
            "kind": "role",
            "role": "link",
            "name": "View savings"
        }
    ],
    "allowed_read_labels": [
        "Member ID",
        "Account type",
        "Available balance",
        "Currency"
    ]
}